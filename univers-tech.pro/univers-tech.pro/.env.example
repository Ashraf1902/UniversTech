APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Base URL of the React frontend. Used in emails (password reset, access-request
# decisions). Set this to the deployed frontend origin in production.
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Render deploy target: PostgreSQL (managed by Render).
# Set these in the Render dashboard (not committed): the Internal Database URL
# from the rendered Postgres instance, or the individual vars below.
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
DB_CONNECTION=pgsql
DB_HOST=<render-postgres-internal-host>
DB_PORT=5432
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

# Local development still uses MySQL: keep the block below (uncomment + switch
# DB_CONNECTION back to mysql to develop against the local instance).
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=univars_tech
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Local/dev uses the "log" mailer (messages are written to the log).
# For production set MAIL_MAILER=smtp (or ses/postmark/mailgun) plus the
# provider credentials below. Never commit real credentials.
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@univers-tech.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe payments
STRIPE_KEY=
STRIPE_SECRET=
PAYMENT_DEMO_MODE=true
PAYMENT_CURRENCY=usd

# Demo seeder: password for the seeded ADMINISTRATOR accounts (super admin and
# the scoped demo admins). Leave empty and the seeder generates a random one
# and prints it. This value is never used for non-admin demo accounts, which
# share DEMO_PASSWORD ("Demo@12345"). Do not commit a real value.
DEMO_SUPER_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"